# Scout deployment environment. Copy to `.env` and set real values before use.
# `.env` is git-ignored; never commit real credentials.

# --- Deployment operator (seeded once, never re-seeded) ----------------------
SCOUT_OPERATOR_EMAIL=operator@scout.local
SCOUT_OPERATOR_PASSWORD=change-me-now

# --- Metadata store ----------------------------------------------------------
# `postgres` is the production default whenever DATABASE_URL is set.
# Set `SCOUT_STORE=memory` only for local development: records will not survive
# a restart and the application warns about it at startup.
DATABASE_URL=postgres://scout:scout@postgres:5432/scout
# SCOUT_STORE=postgres

# --- Object storage (Garage by default) --------------------------------------
SCOUT_S3_ENDPOINT=http://garage:3900
SCOUT_S3_BUCKET=scout-raw
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=garage

# --- Behaviour ---------------------------------------------------------------
SCOUT_SELF_URL=http://127.0.0.1:8080
SCOUT_DEMO_MODE=false
SCOUT_SENTRY_API_COMPAT_ENABLED=false
SCOUT_RETENTION_DAYS=30
SCOUT_RETENTION_INTERVAL_SECONDS=3600
SCOUT_CONFIDENCE_THRESHOLD=0.5
SCOUT_INGEST_MAX_IN_FLIGHT=256
SCOUT_SESSION_TTL_DAYS=7
RUST_LOG=info
